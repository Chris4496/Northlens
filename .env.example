# Gemini (https://aistudio.google.com/apikey). Without it, NorthLens runs in offline mode:
# keyword retrieval + answers composed directly from source passages + rule-based classification.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Supabase (optional). Without it, feedback is stored in .data/feedback.json and
# retrieval uses in-memory embeddings. Server-only secret key — never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
